<Window x:Class="CurrencyExchangeClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Currency Exchange Office" Height="520" Width="620"
        Background="#F4F6F9">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2C2C2A"/>
            <Setter Property="BorderBrush" Value="#D3D1C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2C2C2A"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#2C2C2A"/>
            <Setter Property="BorderBrush" Value="#D3D1C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Title -->
            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                <TextBlock Text="Currency Exchange" FontSize="26" FontWeight="Bold"
                           Foreground="#2C2C2A" HorizontalAlignment="Center"/>
                <TextBlock Text="Real-time rates from NBP API" FontSize="13"
                           Foreground="#888780" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Exchange Rate Section -->
            <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16"
                    BorderBrush="#D3D1C7" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="GET EXCHANGE RATE" Foreground="#888780" 
                               FontSize="11" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="CurrencyComboBox" Width="180">
                            <ComboBoxItem>USD — US Dollar</ComboBoxItem>
                            <ComboBoxItem>EUR — Euro</ComboBoxItem>
                            <ComboBoxItem>GBP — British Pound</ComboBoxItem>
                            <ComboBoxItem>CHF — Swiss Franc</ComboBoxItem>
                            <ComboBoxItem>JPY — Japanese Yen</ComboBoxItem>
                        </ComboBox>
                        <Button Content="Get Rate" Width="110" Margin="10,0,0,0"
                                Background="#185FA5" Foreground="White"
                                Click="GetRate_Click"/>
                    </StackPanel>
                    <Border Background="#F4F6F9" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="RateTextBlock" Text="Select a currency and click Get Rate"
                                       Foreground="#185FA5" FontSize="18" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Currency Conversion Section -->
            <Border Background="White" CornerRadius="12" Padding="20"
                    BorderBrush="#D3D1C7" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="CONVERT CURRENCY" Foreground="#888780"
                               FontSize="11" Margin="0,0,0,12"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="FromComboBox" Grid.Column="0">
                            <ComboBoxItem>USD</ComboBoxItem>
                            <ComboBoxItem>EUR</ComboBoxItem>
                            <ComboBoxItem>GBP</ComboBoxItem>
                            <ComboBoxItem>PLN</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="⇄" Grid.Column="1" FontSize="20"
                                   Foreground="#888780" VerticalAlignment="Center" Margin="10,0"/>
                        <ComboBox x:Name="ToComboBox" Grid.Column="2">
                            <ComboBoxItem>PLN</ComboBoxItem>
                            <ComboBoxItem>USD</ComboBoxItem>
                            <ComboBoxItem>EUR</ComboBoxItem>
                            <ComboBoxItem>GBP</ComboBoxItem>
                        </ComboBox>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="AmountTextBox" Width="220" 
                                 ToolTip="Enter amount"/>
                        <Button Content="Convert" Width="110" Margin="10,0,0,0"
                                Background="#533AB7" Foreground="White"
                                Click="Convert_Click"/>
                    </StackPanel>
                    <Border Background="#F4F6F9" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                        <TextBlock x:Name="ResultTextBlock" Text="Result will appear here..."
                                   Foreground="#533AB7" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>